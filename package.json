{
  "name": "legwork-arc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standing USDC orders on Arc that anyone can execute and be repaid the metered gas + tip from the order's deposit.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:check": "node scripts/js-budget.cjs",
    "lint": "oxlint src scripts test/ts e2e",
    "lint:fix": "oxlint --fix src scripts test/ts e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run audit && npm run lint && npm run typecheck && npm run test:coverage",
    "ci:full": "npm run ci && npm run build && npm run build:check && npm run readiness && npm run e2e",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "security-scan": "npm audit --audit-level=high || true; npx --yes license-checker --production --failOn \"GPL-3.0;AGPL-3.0\" --summary || true; gitleaks detect --no-banner --redact",
    "readiness": "python3 scripts/preflight.py",
    "orders": "tsx scripts/orders.ts",
    "bench": "tsx scripts/meter-bench.ts",
    "recheck": "tsx scripts/recheck-receipts.ts",
    "preflight": "python3 scripts/preflight.py"
  },
  "dependencies": {
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.1",
    "oxlint": "^1.83.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "homepage": "https://edycutjong.github.io/legwork-arc/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edycutjong/legwork-arc.git"
  }
}
