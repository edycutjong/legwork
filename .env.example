# Public values only. Keys live in ~/.config, never in this tree. Nothing on the page or in the tests reads this file —
# only the two mainnet-writing scripts (`npm run orders`, `npm run bench`) do.

# ── Arc mainnet ─────────────────────────────────────────────────────────────
# Get from: https://docs.arc.network (References → RPC endpoints); the public endpoint needs no key.
LEGWORK_RPC_URL=https://rpc.mainnet.arc.io

# ── Foundry keystores (the scripts decrypt them in a child `cast` process; the key is never printed) ──
# Get from: `cast wallet import <name> --interactive` — writes ~/.foundry/keystores/<name> or the directory you point at.
# The deployer / payer / executor wallet:
LEGWORK_KEYSTORE=~/.config/arc-microgrants/keystore/<deployer-keystore>
# The demo payee wallet (five bench rows are the payee collecting its own payment):
LEGWORK_PAYEE_KEYSTORE=~/.config/arc-microgrants/keystore/<payee-demo-keystore>
# A file holding the keystore password (chmod 600); read once per script run:
LEGWORK_KEYSTORE_PASSWORD_FILE=~/.config/arc-microgrants/keystore.pass

# ── Optional ────────────────────────────────────────────────────────────────
# Second copy of every receipt written by the scripts, outside the repo:
# LEGWORK_RECEIPT_MIRROR=/path/outside/the/repo
