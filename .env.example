# Public values only. Keys live in ~/.config, never in this tree.
LEGWORK_RPC_URL=https://rpc.mainnet.arc.io
# Foundry keystore for the deployer / executor / payer wallet and its password file:
LEGWORK_KEYSTORE=~/.config/arc-microgrants/keystore/<deployer-keystore>
LEGWORK_PAYEE_KEYSTORE=~/.config/arc-microgrants/keystore/<payee-demo-keystore>
LEGWORK_KEYSTORE_PASSWORD_FILE=~/.config/arc-microgrants/keystore.pass
# Optional second copy of every receipt written by the scripts (outside the repo):
# LEGWORK_RECEIPT_MIRROR=/path/outside/the/repo
